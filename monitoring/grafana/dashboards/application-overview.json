          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (app)",
          "legendFormat": "{{app}} errors",
          "refId": "A"
