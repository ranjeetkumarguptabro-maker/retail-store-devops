      },
      "id": 6,
      "title": "P95 Request Latency by Service",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))",
          "legendFormat": "{{uri}} p95",
          "refId": "A"
        }
      ]
    },
